{
  "$defs": {
    "projectionHints": {
      "additionalProperties": false,
      "properties": {
        "candidate_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "candidate_reason": {
          "type": "string"
        },
        "eligible_after_gates": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "quality": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "conflict_status": {
          "enum": [
            "none",
            "possible_duplicate",
            "conflicting_evidence",
            "needs_review",
            "unknown"
          ],
          "type": "string"
        },
        "review_status": {
          "enum": [
            "not_required",
            "needs_matrix_review",
            "needs_human_review",
            "approved",
            "rejected"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "sourceLineage": {
      "additionalProperties": false,
      "properties": {
        "matrix_mapping_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "payload_hash_refs": {
          "items": {
            "pattern": "^[a-z0-9:_-]+$",
            "type": "string"
          },
          "type": "array"
        },
        "provider_families": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sourcehub_record_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "sourcehub_record_refs"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.prop4you.local/lfg/taxonomy-envelope.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "envelope_kind": {
      "const": "taxonomy",
      "type": "string"
    },
    "privacy_class": {
      "default": "restricted",
      "enum": [
        "public_safe",
        "restricted",
        "pii_sensitive",
        "provider_sensitive",
        "mixed_review_required"
      ],
      "type": "string"
    },
    "projection_hints": {
      "$ref": "#/$defs/projectionHints"
    },
    "quality": {
      "$ref": "#/$defs/quality"
    },
    "residue": {
      "additionalProperties": true,
      "description": "Sanitized JSONB residue only; no raw payload values in docs or public API.",
      "type": "object"
    },
    "schema_version": {
      "const": "v1",
      "type": "string"
    },
    "source_lineage": {
      "$ref": "#/$defs/sourceLineage"
    },
    "source_lineage_taxonomy": {
      "additionalProperties": false,
      "properties": {
        "provider_payload_class": {
          "type": "string"
        },
        "source_list_type_slug": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "system_taxonomy": {
      "additionalProperties": false,
      "properties": {
        "email_tag_slugs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "owner_tag_slugs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "phone_tag_slugs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "situation_statuses": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "situation_types": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "system_property_label_slugs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "system_property_tag_slugs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "workspace_overlay_boundary": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "type": "string"
        },
        "tag_groups_deferred": {
          "type": "boolean"
        },
        "workspace_tags_allowed_later": {
          "type": "boolean"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "envelope_kind",
    "privacy_class",
    "system_taxonomy",
    "source_lineage"
  ],
  "title": "Prop4You LFG taxonomy/tag vocabulary envelope v1",
  "type": "object"
}

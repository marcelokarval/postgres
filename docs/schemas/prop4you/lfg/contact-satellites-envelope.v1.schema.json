{
  "$defs": {
    "projectionHints": {
      "additionalProperties": false,
      "properties": {
        "candidate_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "candidate_reason": {
          "type": "string"
        },
        "eligible_after_gates": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "quality": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "conflict_status": {
          "enum": [
            "none",
            "possible_duplicate",
            "conflicting_evidence",
            "needs_review",
            "unknown"
          ],
          "type": "string"
        },
        "review_status": {
          "enum": [
            "not_required",
            "needs_matrix_review",
            "needs_human_review",
            "approved",
            "rejected"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "sourceLineage": {
      "additionalProperties": false,
      "properties": {
        "matrix_mapping_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "payload_hash_refs": {
          "items": {
            "pattern": "^[a-z0-9:_-]+$",
            "type": "string"
          },
          "type": "array"
        },
        "provider_families": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sourcehub_record_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "sourcehub_record_refs"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.prop4you.local/lfg/contact-satellites-envelope.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "anchor": {
      "additionalProperties": false,
      "properties": {
        "canonical_owner_ref": {
          "type": "string"
        },
        "canonical_property_ref": {
          "type": "string"
        },
        "sourcehub_session_ref": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "counts": {
      "additionalProperties": false,
      "properties": {
        "addresses": {
          "minimum": 0,
          "type": "integer"
        },
        "contacts": {
          "minimum": 0,
          "type": "integer"
        },
        "emails": {
          "minimum": 0,
          "type": "integer"
        },
        "phones": {
          "minimum": 0,
          "type": "integer"
        },
        "relative_phones": {
          "minimum": 0,
          "type": "integer"
        },
        "relatives": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "email_satellites": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "email_token_ref": {
            "type": "string"
          },
          "provider_event_ref": {
            "type": "string"
          },
          "source_json_path": {
            "type": "string"
          }
        },
        "required": [
          "source_json_path",
          "provider_event_ref"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "envelope_kind": {
      "const": "contact_satellites",
      "type": "string"
    },
    "phone_satellites": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "phone_token_ref": {
            "type": "string"
          },
          "phone_type_label": {
            "type": "string"
          },
          "provider_event_ref": {
            "type": "string"
          },
          "source_json_path": {
            "type": "string"
          },
          "source_role": {
            "enum": [
              "contact",
              "relative",
              "unknown"
            ],
            "type": "string"
          }
        },
        "required": [
          "source_json_path",
          "provider_event_ref"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "privacy_class": {
      "default": "pii_sensitive",
      "enum": [
        "public_safe",
        "restricted",
        "pii_sensitive",
        "provider_sensitive",
        "mixed_review_required"
      ],
      "type": "string"
    },
    "projection_hints": {
      "$ref": "#/$defs/projectionHints"
    },
    "provider_status": {
      "additionalProperties": false,
      "properties": {
        "parse_status": {
          "type": "string"
        },
        "provider_slug": {
          "type": "string"
        },
        "result_class": {
          "type": "string"
        },
        "surface_slug": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "quality": {
      "$ref": "#/$defs/quality"
    },
    "residue": {
      "additionalProperties": true,
      "description": "Sanitized JSONB residue only; no raw payload values in docs or public API.",
      "type": "object"
    },
    "schema_version": {
      "const": "v1",
      "type": "string"
    },
    "source_lineage": {
      "$ref": "#/$defs/sourceLineage"
    }
  },
  "required": [
    "schema_version",
    "envelope_kind",
    "privacy_class",
    "anchor",
    "provider_status",
    "source_lineage"
  ],
  "title": "Prop4You LFG contact satellites evidence envelope v1",
  "type": "object"
}

{
  "$defs": {
    "projectionHints": {
      "additionalProperties": false,
      "properties": {
        "candidate_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "candidate_reason": {
          "type": "string"
        },
        "eligible_after_gates": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "quality": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "conflict_status": {
          "enum": [
            "none",
            "possible_duplicate",
            "conflicting_evidence",
            "needs_review",
            "unknown"
          ],
          "type": "string"
        },
        "review_status": {
          "enum": [
            "not_required",
            "needs_matrix_review",
            "needs_human_review",
            "approved",
            "rejected"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "sourceLineage": {
      "additionalProperties": false,
      "properties": {
        "matrix_mapping_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "payload_hash_refs": {
          "items": {
            "pattern": "^[a-z0-9:_-]+$",
            "type": "string"
          },
          "type": "array"
        },
        "provider_families": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sourcehub_record_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "sourcehub_record_refs"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.prop4you.local/lfg/owner-envelope.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_owner_ref": {
      "type": "string"
    },
    "entity": {
      "additionalProperties": false,
      "properties": {
        "deceased_hint": {
          "type": "boolean"
        },
        "display_name_ref": {
          "type": "string"
        },
        "entity_type": {
          "enum": [
            "person",
            "company",
            "trust",
            "unknown"
          ],
          "type": "string"
        },
        "identity_confidence": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "type": "object"
    },
    "envelope_kind": {
      "const": "owner",
      "type": "string"
    },
    "identity_evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "evidence_kind": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          }
        },
        "required": [
          "evidence_kind",
          "source_ref"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ownership": {
      "additionalProperties": false,
      "properties": {
        "ownership_type": {
          "type": "string"
        },
        "property_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "role_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "privacy_class": {
      "default": "pii_sensitive",
      "enum": [
        "public_safe",
        "restricted",
        "pii_sensitive",
        "provider_sensitive",
        "mixed_review_required"
      ],
      "type": "string"
    },
    "projection_hints": {
      "$ref": "#/$defs/projectionHints"
    },
    "quality": {
      "$ref": "#/$defs/quality"
    },
    "residue": {
      "additionalProperties": true,
      "description": "Sanitized JSONB residue only; no raw payload values in docs or public API.",
      "type": "object"
    },
    "schema_version": {
      "const": "v1",
      "type": "string"
    },
    "source_lineage": {
      "$ref": "#/$defs/sourceLineage"
    }
  },
  "required": [
    "schema_version",
    "envelope_kind",
    "privacy_class",
    "entity",
    "source_lineage"
  ],
  "title": "Prop4You LFG owner canonical envelope v1",
  "type": "object"
}

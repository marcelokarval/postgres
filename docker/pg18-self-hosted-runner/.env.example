# GitHub repository URL for the runner target
REPO_URL=https://github.com/your-org/your-repo

# Short-lived registration token generated in GitHub Actions runner settings
RUNNER_TOKEN=replace-me

# Visible runner name in GitHub
RUNNER_NAME=pg18-self-hosted-01

# Must match the labels expected by .github/workflows/pg18-validation-self-hosted.yml
LABELS=self-hosted,blacksmith-4vcpu-ubuntu-2404
